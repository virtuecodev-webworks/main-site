{
  "name": "virtue-co-webworks",
  "version": "0.1.0",
  "private": true,
  "description": "Virtue & Co. Webworks — ultra-sleek web engineering & digital experience agency.",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "verify:design": "node ./node_modules/typescript/bin/tsc --ignoreConfig src/lib/design/tokens.ts src/lib/design/palette.ts src/lib/design/fonts.ts src/lib/design/css.ts --outDir .design-check --module commonjs --target es2022 --moduleResolution node --lib es2022 --skipLibCheck --esModuleInterop --ignoreDeprecations 6.0 && node scripts/design-selfcheck.mjs .design-check",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"remotion/**/*.{ts,tsx}\"",
    "remotion:studio": "node ./node_modules/@remotion/cli/remotion-cli.js studio src/remotion/index.ts",
    "remotion:render": "node ./node_modules/@remotion/cli/remotion-cli.js render src/remotion/index.ts VirtueLogoIntro out/virtue-logo-intro.mp4",
    "remotion:landscape": "node ./node_modules/@remotion/cli/remotion-cli.js render src/remotion/index.ts VirtueBrandLandscape out/virtue-brand-landscape.mp4",
    "remotion:portrait": "node ./node_modules/@remotion/cli/remotion-cli.js render src/remotion/index.ts VirtueBrandPortrait out/virtue-brand-portrait.mp4",
    "remotion:gif": "node ./node_modules/@remotion/cli/remotion-cli.js render src/remotion/index.ts VirtueLogoIntro out/virtue-logo-intro.gif --codec=gif --every-nth-frame=2",
    "remotion:still": "node ./node_modules/@remotion/cli/remotion-cli.js still src/remotion/index.ts VirtueBrandLandscape out/brand-landscape.png --frame=100",
    "remotion:still-portrait": "node ./node_modules/@remotion/cli/remotion-cli.js still src/remotion/index.ts VirtueBrandPortrait out/brand-portrait.png --frame=100"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-email/render": "^2.1.1",
    "@remotion/fonts": "^4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/player": "4.0.536",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^14.3.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "remotion": "4.0.536",
    "resend": "^6.33.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.536",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
