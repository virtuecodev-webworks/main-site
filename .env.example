# ==============================================================================
# Virtue & Co. Webworks — environment template
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ==============================================================================

# --- Site ---------------------------------------------------------------------
# Canonical origin. Used for sitemap, robots, hreflang and Resend links.
NEXT_PUBLIC_SITE_URL="https://virtuecowebworks.solutions"
NEXT_PUBLIC_AGENCY_EMAIL="admin@virtuecowebworks.solutions"

# --- Supabase -----------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Service role key. SERVER ONLY — bypasses RLS. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Resend (transactional email) --------------------------------------------
# Create at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified domain in Resend.
RESEND_FROM_EMAIL="Virtue & Co. Webworks <admin@virtuecowebworks.solutions>"
# Internal notification recipient for new leads.
LEAD_NOTIFICATION_EMAIL="admin@virtuecowebworks.solutions"

# --- Flutterwave (payments) ---------------------------------------------------
# Dashboard -> Settings -> API keys
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-x"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-x"
FLUTTERWAVE_SECRET_KEY_PROD=""
# Dashboard -> Settings -> Webhooks, same value for `verif-hash`
FLUTTERWAVE_WEBHOOK_HASH="<your-webhook-secret-hash>"
# Where Flutterwave sends the buyer back to after a successful charge.
NEXT_PUBLIC_FLUTTERWAVE_REDIRECT_URL="https://virtuecowebworks.solutions/en/payment/success"

# --- Admin --------------------------------------------------------------------
# Comma-separated allow-list of emails that may sign in to /admin.
ADMIN_EMAIL_ALLOWLIST="admin@virtuecowebworks.solutions,divine@virtuecowebworks.solutions,glory@virtuecowebworks.solutions,virtueco.dev@gmail.com"
